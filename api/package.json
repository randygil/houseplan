{
  "name": "plata-api",
  "version": "1.0.0",
  "scripts": {
    "build": "prisma generate && tsc -p .",
    "start": "prisma migrate deploy && node dist/main.js",
    "dev": "tsc -p . && node --env-file=../.env --watch dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsc -p . && node --env-file=../.env dist/db/seed.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p . && node --test \"dist/**/*.test.js\""
  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
